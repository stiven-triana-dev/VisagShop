{
  "name": "visagshop",
  "version": "6.0.0",
  "description": "VisagShop - tienda de moda urbana con Express, EJS, PostgreSQL y Sequelize",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "check": "node --check app.js",
    "test": "node --test tests/*.test.js",
    "seed:users": "node scripts/seedDemoUsers.js",
    "catalog:import": "node scripts/importCatalog.js",
    "db:data-sql": "node scripts/generateDataSql.js",
    "test:db": "node --test tests/database.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-validator": "^7.3.2",
    "pg": "^8.16.3",
    "sequelize": "^6.37.8"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "15.15.0",
    "prettier": "3.10.1",
    "sequelize-cli": "^6.6.5"
  }
}
