<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="contenido" class="inner-main shell sprint4-list">
 <div class="breadcrumbs"><a href="/">INICIO</a><span>/</span><span>PRODUCTOS</span></div>
 <div class="page-title"><span class="kicker">VISAGSHOP / COLECCIÓN</span><h1>TODOS LOS <i>productos.</i></h1><p>Todas nuestras prendas en un solo lugar. Busca por nombre o filtra por categoría.</p></div>
 <form class="product-search" action="/products" method="get" role="search">
  <label class="product-search-field"><span class="sr-only">Buscar productos</span><input type="search" name="q" value="<%= q %>" maxlength="80" placeholder="Buscar: jean, gorra, Nike…"></label>
  <label class="product-search-field"><span class="sr-only">Categoría</span><select name="categoria"><option value="">Todas las categorías</option><% categories.forEach(function(c){ %><option value="<%= c %>" <%= categoria===c?'selected':'' %>><%= c %></option><% }) %></select></label>
  <button class="btn btn-dark" type="submit">BUSCAR</button>
  <% if (q || categoria) { %><a class="product-search-clear" href="/products">Limpiar</a><% } %>
 </form>
 <p class="sprint4-list-intro"><% if (q || categoria) { %><%= total %> resultado<%= total===1?'':'s' %><% if (q) { %> para “<%= q %>”<% } %><% if (categoria) { %> en <%= categoria %><% } %><% } else { %><%= total %> referencias<% } %><% if (pages > 1) { %> · Página <%= page %> de <%= pages %><% } %> · Los precios y la disponibilidad final se confirman con VisagShop.</p>
 <% if (!total) { %><p class="product-search-empty">No encontramos productos con esa búsqueda. Prueba con otra palabra o <a href="/products">mira toda la colección</a>.</p><% } %>
 <div class="productos sprint4-grid">
 <% products.forEach(function(p,index){ %>
  <%- include('../partials/productCard',{p,index,money}) %>
 <% }) %>
 </div>
 <% if (pages > 1) { %>
 <nav class="pagination" aria-label="Páginas de productos">
  <% if (page > 1) { %><a class="pagination-step" href="<%= pageLink(page-1) %>" rel="prev">← ANTERIOR</a><% } else { %><span class="pagination-step" aria-hidden="true">← ANTERIOR</span><% } %>
  <ol class="pagination-pages">
   <% for (let n = 1; n <= pages; n++) { %>
    <li><% if (n === page) { %><span aria-current="page"><%= n %></span><% } else { %><a href="<%= pageLink(n) %>" aria-label="Página <%= n %>"><%= n %></a><% } %></li>
   <% } %>
  </ol>
  <% if (page < pages) { %><a class="pagination-step" href="<%= pageLink(page+1) %>" rel="next">SIGUIENTE →</a><% } else { %><span class="pagination-step" aria-hidden="true">SIGUIENTE →</span><% } %>
 </nav>
 <% } %>
 <div class="sprint4-list-end"><a href="/" class="btn btn-outline-dark">VOLVER A LA TIENDA ↗</a></div>
</main>
<%- include('../partials/footer') %>
