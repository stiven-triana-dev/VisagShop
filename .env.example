# CONFIGURAR EN RENDER > Environment. NO publiques valores reales en GitHub.
NODE_ENV=production
DATABASE_URL=postgresql://USUARIO:CONTRASENA@SERVIDOR.neon.tech/neondb?sslmode=require
ADMIN_USERNAME=tu_usuario_privado
ADMIN_PASSWORD=contraseña_larga_unica_de_al_menos_16_caracteres
# Render proporciona PORT automáticamente.
# No guardes claves de clientes o de administración en el ZIP ni en el repositorio.
WHATSAPP_NUMBER=57XXXXXXXXXX
# Asistente con IA (VisagAssist, servicio aparte). Sin estas dos variables la burbuja no aparece.
VISAGASSIST_URL=https://visagassist.onrender.com
# El MISMO secreto que tiene VisagAssist (mínimo 32 caracteres).
VISAGASSIST_SECRETO=
